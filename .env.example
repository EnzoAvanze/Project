# Node.js 24+. Copie para .env apenas se precisar mudar os padrões.
PORT=3001
DB_PATH=.data/cuidali.sqlite
# HTTPS em produção (obrigatório para dados reais)
COOKIE_SECURE=false
# Somente para o invólucro Expo em dispositivo físico:
# EXPO_PUBLIC_APP_URL=https://seu-dominio.example
# Sem provedor externo configurado: notificações são internas, sem push/SMS.
